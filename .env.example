# Firebase web config for the production build.
#
# These values are PUBLIC: they are baked into the JS bundle at build time and
# are protected by Firestore rules + API-key restrictions, NOT by secrecy.
# Copy this file to `.env` (gitignored) and fill in the real project values.
# Docker Compose reads `.env` and passes them as build args to the image.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
